# ============================================================================
# StudentHub Portal - Environment Configuration Template
# Practical 15: Final Integration & Deployment Packaging
# ============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="StudentHub Portal"
APP_URL=http://localhost/StudentHub
APP_VHOST_URL=http://studenthub.local

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studenthub_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Security & Session Settings
SESSION_LIFETIME=900
CSRF_SECRET_KEY=studenthub_secure_csrf_token_secret_key_2026
BCRYPT_COST=10

# File Upload Constraints
UPLOAD_MAX_FILESIZE=2097152
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_POSTERS_DIR=uploads/posters/

# Academic Institution Info
CAMPUS_NAME="Devang Patel Institute of Advance Technology and Research (DEPSTAR)"
UNIVERSITY_NAME="Charotar University of Science and Technology (CHARUSAT)"
COURSE_CODE=ITUE203
COURSE_NAME="Web Development Frameworks"
